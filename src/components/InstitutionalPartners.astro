---
const endorsementModules = [
  {
    title: 'Directorate of Sports & Student Welfare',
    description:
      'Recognized as a varsity sports code. Eligible for official sports documentation, faculty leagues, and university representation.',
    iconType: 'kyu',
  },
  {
    title: 'Tribe by Carry1st',
    description:
      'Integrated into the African gaming ecosystem, featuring structured competition frameworks and verified reward distributions.',
    iconType: 'tribe',
  },
  {
    title: 'Institutional Registry',
    description:
      'Connected to verified student credentials (@students.kyu.ac.ke) to ensure transparent roster selection.',
    iconType: 'registry',
  },
];
---

<section class="relative">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Partner Strip Banner Title (.home-partners_section style) -->
        <div class="flex flex-col items-center text-center mb-10 sm:mb-12">
          <h2 class="font-display-impact text-xl xs:text-2xl sm:text-3xl lg:text-4xl text-white max-w-4xl tracking-wider leading-snug">
            SANCTIONED BY UNIVERSITY ADMINISTRATION · <span class="text-[#fbaf17]">POWERED BY AFRICA'S LARGEST GAMING NETWORK</span>
          </h2>
        </div>

        <!-- 3-Column Frosted Glass Endorsement Modules (.key-feature-wrapper archetype) -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {
            endorsementModules.map((mod) => (
              <article class="glass-feature-card flex flex-col justify-between">
                <div>
                  <div class="mb-5 sm:mb-6">
                    <!-- 55x55px rounded-10px icon badge -->
                    <div class="w-[50px] h-[50px] sm:w-[55px] sm:h-[55px] rounded-[12px] bg-gradient-to-br from-[#07a3e1] to-[#0a60cd] p-2 sm:p-2.5 flex items-center justify-center shadow-lg shrink-0">
                      {mod.iconType === 'kyu' && (
                        <img
                          src="/images/kyu_logo2.svg"
                          alt="Kirinyaga University Directorate of Sports"
                          class="w-full h-full object-contain"
                        />
                      )}
                      {mod.iconType === 'tribe' && (
                        <img
                          src="/images/tribelogo.svg"
                          alt="Tribe by Carry1st"
                          class="w-full h-full object-contain"
                        />
                      )}
                      {mod.iconType === 'registry' && (
                        <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                          />
                        </svg>
                      )}
                    </div>
                  </div>

                  <h3 class="text-lg sm:text-[22px] font-bold text-white leading-snug">
                    {mod.title}
                  </h3>

                  <div class="feature-divider" />

                  <p class="text-[15px] leading-[1.65] text-white/80">
                    {mod.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
