---
const studentPerks = [
  {
    title: 'Free Campus Matches & LANs',
    description:
      'Compete in weekly online rooms and live campus game nights. Zero entry fees, zero barrier to play.',
    iconType: 'gaming',
  },
  {
    title: 'Win Real Airtime & Game Coins',
    description:
      'Earn points every match. Cash them out instantly on the Carry1st Shop for Safaricom/Airtel airtime, data bundles, and CP.',
    iconType: 'rewards',
  },
  {
    title: 'Represent KyU Across Kenya',
    description:
      'Squad up with campus teammates to challenge rival universities in official inter-campus invitationals and split finals.',
    iconType: 'varsity',
  },
];
---

<section class="relative">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Section Header -->
        <div class="flex flex-col items-center text-center mb-10 sm:mb-12">
          <p class="font-mono text-xs font-bold uppercase tracking-[0.2em] text-[#fbaf17] mb-2">
            WHY STUDENTS PLAY
          </p>
          <h2 class="font-display-impact text-2xl xs:text-3xl sm:text-4xl lg:text-5xl text-white max-w-3xl tracking-wider leading-snug">
            Built by Gamers, <span class="text-[#fbaf17]">Recognized on Campus.</span>
          </h2>
        </div>

        <!-- 3-Column Perk Cards -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
          {
            studentPerks.map((perk) => (
              <article class="glass-feature-card flex flex-col justify-between">
                <div>
                  <div class="mb-5 sm:mb-6">
                    <div class="w-[50px] h-[50px] sm:w-[55px] sm:h-[55px] rounded-[12px] bg-gradient-to-br from-[#07a3e1] to-[#0a60cd] p-2 sm:p-2.5 flex items-center justify-center shadow-lg shrink-0">
                      {perk.iconType === 'gaming' && (
                        <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      )}
                      {perk.iconType === 'rewards' && (
                        <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                      )}
                      {perk.iconType === 'varsity' && (
                        <svg class="w-6 h-6 sm:w-7 sm:h-7 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                        </svg>
                      )}
                    </div>
                  </div>

                  <h3 class="text-lg sm:text-[22px] font-bold text-white leading-snug">
                    {perk.title}
                  </h3>

                  <div class="feature-divider" />

                  <p class="text-[15px] leading-[1.65] text-white/80">
                    {perk.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
