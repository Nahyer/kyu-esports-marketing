---
import RegistrationEngine from './RegistrationEngine';
---

<section id="register" class="relative scroll-mt-24">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Section Header -->
        <div class="flex flex-col items-start lg:items-center lg:text-center mb-12">
          <h2 class="heading-section text-white max-w-4xl mb-4">
            Join in <span class="text-tribe-gold">60 Seconds</span>
          </h2>
          <p class="text-[17px] sm:text-[19px] leading-[1.6] text-white/80 max-w-3xl">
            Three fast steps to claim your free welcome perks, unlock campus tournaments, and enter the official KyU WhatsApp gaming clan.
          </p>
        </div>

        <!-- Dual-Tone 40px Split Conversion Card (.contact-component.comm) -->
        <RegistrationEngine client:visible />
      </div>
    </div>
  </div>
</section>
