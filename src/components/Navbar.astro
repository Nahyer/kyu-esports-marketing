---
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isRegisterPage = currentPath === '/register';

const rawNavLinks = [
  { label: 'Games', href: isRegisterPage ? '/#games' : '#games' },
  { label: 'Rewards & Reach', href: isRegisterPage ? '/#reach' : '#reach' },
  { label: 'Events', href: isRegisterPage ? '/#events' : '#events' },
  { label: 'Community', href: isRegisterPage ? '/#community' : '#community' },
];

const navLinks = rawNavLinks;
---

<header
  id="main-navbar"
  class:list={[
    "fixed top-0 inset-x-0 z-50 w-full transition-all duration-300 transform translate-y-0",
    isRegisterPage
      ? "bg-white/80 backdrop-blur-md border-b border-slate-200"
      : "bg-black/40 backdrop-blur-md border-b border-white/5",
  ]}
>
  <div class="padding-global">
    <div class="container-large flex items-center justify-between h-[76px] sm:h-[88px] lg:h-[100px] gap-2 sm:gap-4">
      <!-- Left Brand Identity -->
      <a href="/" class="flex items-center gap-2 sm:gap-3.5 group shrink min-w-0">
        <div class="flex items-center gap-2 sm:gap-3 shrink-0">
          <img
            src="/images/kyu_logo2.svg"
            alt="Kirinyaga University"
            class="h-7 xs:h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105"
          />
          <div class="h-5 sm:h-6 w-[1px] bg-white/20"></div>
          <img
            src="/images/tribelogo.svg"
            alt="Tribe by Carry1st"
            class="h-7 xs:h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105"
          />
        </div>
        <div class="flex flex-col min-w-0">
          <span
            class:list={[
              "font-display-impact text-lg xs:text-xl sm:text-2xl lg:text-[26px] tracking-wider leading-none group-hover:text-[#fbaf17] transition-colors truncate",
              isRegisterPage ? "text-[#161b25]" : "text-white",
            ]}
          >
            KIRINYAGA UNIVERSITY ESPORTS
          </span>
          <span
            class:list={[
              "text-[10px] sm:text-xs font-medium tracking-wide mt-0.5 truncate",
              isRegisterPage ? "text-slate-600" : "text-[#7e8a9e]",
            ]}
          >
            Powered by <span class="text-[#fbaf17] font-semibold">Tribe Carry1st</span>
          </span>
        </div>
      </a>

      <!-- Center Navigation Links (Desktop - Compact) -->
      <nav aria-label="Main Navigation" class="hidden lg:flex items-center gap-6 xl:gap-7 shrink-0">
        {
          navLinks.map((link) => (
            <a
              href={link.href}
              class:list={[
                "relative text-[14px] font-medium hover:text-[#fbaf17] transition-colors whitespace-nowrap",
                isRegisterPage ? "text-[#161b25]/85" : "text-white/80",
              ]}
            >
              {link.label}
            </a>
          ))
        }
      </nav>

      <!-- Right Conversion CTA + Mobile Drawer Trigger -->
      <div class="flex items-center gap-2 sm:gap-3 shrink-0">
        <!-- "Check Status" Action Pill - Matches the Carry1st / Tribe secondary nav pill style -->
        <button
          type="button"
          data-status-drawer-trigger
          class:list={[
            "inline-flex items-center justify-center rounded-full text-xs sm:text-[14px] font-semibold transition-all duration-150 active:scale-95 cursor-pointer",
            isRegisterPage
              ? "px-3.5 sm:px-4 py-2 sm:py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-800 border border-slate-300 shadow-xs"
              : "px-3.5 sm:px-4 py-2 sm:py-2.5 bg-transparent hover:bg-white text-white hover:text-black border-2 border-white/30 hover:border-white",
          ]}
        >
          Check Status
        </button>

        <!-- Desktop Roster CTA (Hidden on mobile and hidden on /register) -->
        {
          !isRegisterPage && (
            <div class="!hidden lg:!inline-flex nav-button-wrapper">
              <a href="/register" class="primary-button-dark">
                <span>Join Us</span>
                <svg class="w-4 h-4 text-[#fbaf17]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          )
        }

        <!-- Mobile Menu Details/Summary Drawer -->
        <details class="lg:hidden relative group mobile-menu-details">
          <summary
            aria-label="Toggle Navigation Menu"
            class="list-none cursor-pointer w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-[#161b25] border-2 border-[#202835] flex items-center justify-center text-white hover:border-[#fbaf17] transition-colors select-none"
          >
            <svg class="w-5 h-5 group-open:hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="w-5 h-5 hidden group-open:block text-[#fbaf17]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </summary>

          <div class="fixed inset-x-3 top-[84px] sm:absolute sm:inset-x-auto sm:right-0 sm:top-auto sm:mt-3 w-auto sm:w-80 rounded-[24px] bg-[#161b25]/98 backdrop-blur-xl border-[3px] border-[#202835] p-5 sm:p-6 shadow-[0_20px_50px_rgba(0,0,0,0.85)] flex flex-col gap-4 z-50">
            <div class="text-[11px] font-semibold uppercase tracking-widest text-[#7e8a9e] pb-2 border-b border-white/10 flex items-center justify-between">
              <span>Official Varsity Navigation</span>
              <span class="text-[10px] text-[#fbaf17] font-mono">KYU × TRIBE</span>
            </div>
            <div class="flex flex-col gap-1.5">
              <button
                type="button"
                data-status-drawer-trigger
                class="mobile-nav-link text-left px-3.5 py-3 rounded-xl text-[15px] font-medium text-white/90 hover:text-black hover:bg-[#fbaf17] transition-colors flex items-center justify-between active:scale-[0.99] cursor-pointer"
              >
                <span>Check Status</span>
                <span class="text-xs text-white/40">Open &rarr;</span>
              </button>
              {
                navLinks.map((link) => (
                  <a
                    href={link.href}
                    class="mobile-nav-link px-3.5 py-3 rounded-xl text-[15px] font-medium text-white/90 hover:text-black hover:bg-[#fbaf17] transition-colors flex items-center justify-between active:scale-[0.99]"
                  >
                    <span>{link.label}</span>
                    <span class="text-xs text-white/40">→</span>
                  </a>
                ))
              }
            </div>
            {
              !isRegisterPage && (
                <div class="pt-2 border-t border-white/10">
                  <div class="nav-button-wrapper w-full flex">
                    <a href="/register" class="primary-button-dark w-full justify-center !py-3">
                      <span>Join Us</span>
                      <svg class="w-4 h-4 text-[#fbaf17]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                      </svg>
                    </a>
                  </div>
                </div>
              )
            }
          </div>
        </details>
      </div>
    </div>
  </div>
</header>

{/* Mobile Persistent Floating Bottom CTA (Always visible while scrolling on mobile) */}
{
  !isRegisterPage && (
    <aside
      id="mobile-sticky-cta"
      aria-label="Mobile Persistent Roster Registration"
      class="fixed bottom-3 inset-x-3 sm:inset-x-6 z-40 lg:hidden max-w-md mx-auto transition-all duration-300 pb-[env(safe-area-inset-bottom,0px)]"
    >
      <div class="nav-button-wrapper w-full flex shadow-[0_10px_35px_rgba(0,0,0,0.95),0_0_20px_rgba(251,175,23,0.3)]">
        <a
          href="/register"
          class="primary-button-dark w-full justify-center !py-3.5 !text-[15px] font-bold"
        >
          <span>Join Us</span>
          <svg
            class="w-4 h-4 text-[#fbaf17] shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2.5"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </aside>
  )
}

<script>
  // Mobile drawer UX & Dynamic Scroll Direction Handler (Hide on scroll down, show on scroll up)
  const navbar = document.getElementById('main-navbar');
  const mobileDetails = document.querySelector('.mobile-menu-details') as HTMLDetailsElement | null;
  const stickyCta = document.getElementById('mobile-sticky-cta');

  let lastScrollY = window.scrollY;

  window.addEventListener('scroll', () => {
    const currentScrollY = window.scrollY;

    // Do not hide navbar if the mobile menu drawer is currently expanded
    const isDrawerOpen = mobileDetails?.hasAttribute('open');

    if (navbar && !isDrawerOpen) {
      if (currentScrollY > lastScrollY && currentScrollY > 80) {
        // Scrolling DOWN -> slide navbar up out of view
        navbar.classList.add('-translate-y-full');
        navbar.classList.remove('translate-y-0');
      } else if (currentScrollY < lastScrollY || currentScrollY <= 10) {
        // Scrolling UP -> reveal navbar
        navbar.classList.remove('-translate-y-full');
        navbar.classList.add('translate-y-0');
      }

      // Seamlessly adapt background opacity based on scroll position
      if (currentScrollY > 50) {
        navbar.classList.add('bg-black/80', 'backdrop-blur-xl', 'border-white/10');
        navbar.classList.remove('bg-black/40', 'border-white/5');
      } else {
        navbar.classList.remove('bg-black/80', 'border-white/10');
        navbar.classList.add('bg-black/40', 'border-white/5');
      }
    }

    lastScrollY = currentScrollY <= 0 ? 0 : currentScrollY;
  }, { passive: true });

  if (mobileDetails) {
    // Hide floating bottom CTA when drawer is opened to prevent visual clash
    if (stickyCta) {
      mobileDetails.addEventListener('toggle', () => {
        if (mobileDetails.open) {
          stickyCta.classList.add('opacity-0', 'pointer-events-none', 'translate-y-4');
        } else {
          stickyCta.classList.remove('opacity-0', 'pointer-events-none', 'translate-y-4');
        }
      });
    }

    // Close on navigation link tap
    mobileDetails.querySelectorAll('a, button').forEach((elem) => {
      elem.addEventListener('click', () => {
        mobileDetails.removeAttribute('open');
      });
    });

    // Close when tapping outside
    document.addEventListener('click', (event) => {
      if (mobileDetails.hasAttribute('open') && !mobileDetails.contains(event.target as Node)) {
        mobileDetails.removeAttribute('open');
      }
    });
  }

  // Bind all [data-status-drawer-trigger] buttons to dispatch 'open-status-drawer'
  document.querySelectorAll('[data-status-drawer-trigger]').forEach((btn) => {
    btn.addEventListener('click', (e) => {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-status-drawer'));
    });
  });
</script>
