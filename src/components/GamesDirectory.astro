---
const tierOverview = [
  {
    tier: 'TIER 1: COMPETITIVE LEAGUES',
    accent: '#fbaf17',
    items: [
      'eFootball Mobile (1v1 Ladder)',
      'CODM (5v5 Tactical S&D)',
      'PUBG Mobile (Squad Battle Royale)',
    ],
  },
  {
    tier: 'TIER 2: CASUAL & FUN ROOMS',
    accent: '#00a1e1',
    items: [
      'Free Fire, FC Mobile & MLBB',
      'Chess & Ludo Mobile',
      'Weekly Zero-Stress Fun Rooms',
    ],
  },
  {
    tier: 'TIER 3: VOTE FOR NEW GAMES',
    accent: '#22c55e',
    items: [
      'Student Game Voting Engine',
      '15 Student Votes = New Official WhatsApp Group',
    ],
  },
];

const tier1Divisions = [
  {
    id: 'efootball',
    title: 'eFootball Mobile',
    formatTag: '1v1 LADDER',
    discipline: '1v1 Football Matches on Mobile.',
    format: 'Weekly matches, faculty knockouts, and campus tournament finals.',
    prizes: 'Carry1st Discount Points (CDP) for top winners.',
    selectValue: 'eFootball Mobile',
  },
  {
    id: 'codm',
    title: 'Call of Duty: Mobile (CODM)',
    formatTag: '5v5 SEARCH & DESTROY',
    discipline: '5v5 Tactical FPS on Mobile.',
    format: 'Squad matches and free-agent draft pools for solo players.',
    prizes: 'Team CDP prize pools & in-game CP.',
    selectValue: 'Call of Duty: Mobile (CODM)',
  },
  {
    id: 'pubgm',
    title: 'PUBG Mobile (PUBG-M)',
    formatTag: 'SQUAD BATTLE ROYALE',
    discipline: '4-Player Battle Royale.',
    format: 'Custom campus lobbies, survival ranking, and inter-university scrims.',
    prizes: 'Placement points & kill-multiplier CDP drops.',
    selectValue: 'PUBG Mobile (PUBG-M)',
  },
];

const tier2Titles = [
  'EA Sports FC Mobile',
  'Free Fire',
  'Mobile Legends: Bang Bang',
  'Ludo King',
  'Chess.com',
];

const pitchedCandidates = [
  { name: 'Mortal Kombat', votes: 12 },
  { name: 'Tekken', votes: 14 },
  { name: 'Clash Royale', votes: 9 },
  { name: 'Brawl Stars', votes: 11 },
  { name: 'Apex Legends Mobile', votes: 8 },
];
---

<section id="divisions" class="relative scroll-mt-24">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Section Header -->
        <div class="flex flex-col items-start lg:items-center lg:text-center mb-12">
          <h2 class="heading-section text-white max-w-4xl mb-4">
            Pick Your Game. <span class="text-tribe-gold">Find Your Squad.</span>
          </h2>
          <p class="text-[17px] sm:text-[19px] leading-[1.6] text-white/80 max-w-3xl">
            Under the Tribe manifesto: if you play games, you are a gamer. Whether you play competitively or just want to chill between lectures, there is a place for you.
          </p>
        </div>

        <!-- THE 3-TIER DIRECTORY Architecture Overview Matrix -->
        <div class="rounded-[26px] bg-[#191f2a] border-[3px] border-[#202835] overflow-hidden mb-14 shadow-xl">
          <div class="bg-[#161b25] px-6 py-3.5 border-b border-[#202835] flex items-center justify-between">
            <span class="font-mono text-xs font-semibold uppercase tracking-[0.18em] text-[#fbaf17]">
              HOW OUR GAMING CLUB IS STRUCTURED
            </span>
            <span class="font-mono text-[11px] text-[#7e8a9e] hidden sm:inline">
              KYU &amp; TRIBE GAMING ECOSYSTEM
            </span>
          </div>
          <div class="grid grid-cols-1 lg:grid-cols-3 divide-y lg:divide-y-0 lg:divide-x divide-[#202835]">
            {
              tierOverview.map((col) => (
                <div class="p-5 sm:p-8">
                  <div class="flex items-center gap-2.5 mb-4">
                    <span class="w-2.5 h-2.5 rounded-full" style={`background-color: ${col.accent};`} />
                    <h3 class="font-mono text-sm font-bold uppercase tracking-wider text-white">
                      {col.tier}
                    </h3>
                  </div>
                  <ul class="space-y-2.5">
                    {col.items.map((item) => (
                      <li class="flex items-start gap-2.5 text-[15px] text-white/85">
                        <span class="text-[#fbaf17] font-bold">•</span>
                        <span>{item}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>

        <!-- Tier 1: Official Varsity Divisions (3-Column Outlined Dark Cards .div-block-2834) -->
        <div class="mb-6">
          <h3 class="font-display-impact text-3xl sm:text-4xl lg:text-5xl text-white">
            Tier 1: Competitive Leagues (Prize Tournaments)
          </h3>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-7 mb-12">
          {
            tier1Divisions.map((div) => (
              <article class="division-card-dark group">
                <div>
                  <div class="font-mono text-xs text-[#7e8a9e] tracking-wider uppercase mb-2">
                    {div.formatTag}
                  </div>

                  <!-- Game Title -->
                  <h4 class="text-2xl sm:text-[26px] font-bold text-white mb-4 group-hover:text-[#fbaf17] transition-colors">
                    {div.title}
                  </h4>

                  <div class="feature-divider" />

                  <!-- Structured Specs from tribecontent.md -->
                  <dl class="space-y-4 text-[15px] leading-[1.6] mb-8">
                    <div>
                      <dt class="text-xs font-mono uppercase tracking-wider text-[#7e8a9e] mb-0.5">
                        Discipline
                      </dt>
                      <dd class="text-white font-medium">{div.discipline}</dd>
                    </div>
                    <div>
                      <dt class="text-xs font-mono uppercase tracking-wider text-[#7e8a9e] mb-0.5">
                        Competition Format
                      </dt>
                      <dd class="text-white/80">{div.format}</dd>
                    </div>
                    <div>
                      <dt class="text-xs font-mono uppercase tracking-wider text-[#fbaf17] mb-0.5">
                        Prizes
                      </dt>
                      <dd class="text-white font-medium text-sm">{div.prizes}</dd>
                    </div>
                  </dl>
                </div>

                <!-- Bottom Pill CTA (.primary-button-12.is-white.comm) -->
                <a
                  href={`/register?game=${encodeURIComponent(div.selectValue)}`}
                  class="primary-button-white w-full justify-center select-division-trigger"
                >
                  <span>Claim {div.title.split(' ')[0]} Spot</span>
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                  </svg>
                </a>
              </article>
            ))
          }
        </div>

        <!-- Tier 2: Community Fun Rooms (.join-section-2.shop Electric Blue Split Card) -->
        <div class="split-card-blue p-5 sm:p-8 lg:p-14 mb-12 shadow-2xl">
          <!-- Subtle decorative circle -->
          <div class="pointer-events-none absolute -top-24 -right-24 w-96 h-96 rounded-full border-[44px] border-white/10"></div>

          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
            <div class="lg:col-span-7">
              <h3 class="heading-split text-white mb-4">
                Tier 2: Casual &amp; Fun Rooms (Social Play)
              </h3>

              <p class="text-base sm:text-xl font-semibold text-[#fbaf17] mb-6">
                Zero pressure. No skill level required.
              </p>

              <div class="space-y-4 mb-6">
                <p class="text-[15px] sm:text-[16px] text-white/90 leading-relaxed">
                  <strong class="text-white font-bold">Weekly Fun Rooms:</strong> Open friendly matches hosted every week so students can relax, stream music, and game socially.
                </p>
                <p class="text-[15px] sm:text-[16px] text-white/90 leading-relaxed">
                  <strong class="text-[#fbaf17] font-bold">Free Perks:</strong> Community giveaways, random match drops, and Carry1st store vouchers.
                </p>
              </div>
            </div>

            <div class="lg:col-span-5 bg-[#161b25] rounded-[18px] sm:rounded-[22px] p-5 sm:p-8 border-2 border-white/15 shadow-xl flex flex-col justify-between gap-6">
              <div>
                <span class="font-mono text-xs uppercase tracking-widest text-[#00a1e1] block mb-3">
                  SUPPORTED FUN ROOM GAMES
                </span>
                <div class="flex flex-wrap gap-2 sm:gap-2.5 mb-6">
                  {
                    tier2Titles.map((title) => (
                      <span class="px-3 py-1.5 sm:px-3.5 sm:py-2 rounded-xl bg-[#191f2a] border border-[#202835] text-xs sm:text-sm font-medium text-white">
                        {title}
                      </span>
                    ))
                  }
                </div>
                <p class="text-xs text-[#7e8a9e] leading-relaxed">
                  Choose Fun Rooms in the quick registration form to get an invite to our main WhatsApp social clan.
                </p>
              </div>

              <a
                href="/register?game=Community%20Fun%20Rooms%20(FC%20Mobile%20%2F%20Free%20Fire%20%2F%20MLBB%20%2F%20Chess%20%2F%20Ludo)"
                class="primary-button-gold w-full justify-center select-division-trigger !py-3 sm:!py-3.5 text-sm sm:text-base text-center"
              >
                <span>Join Casual Fun Rooms</span>
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Tier 3: "Pitch Your Game" Voting Engine (26px Outlined Banner Box) -->
        <div class="rounded-[20px] sm:rounded-[26px] bg-[#191f2a] border-[2px] sm:border-[3px] border-[#fbaf17]/70 p-5 sm:p-8 lg:p-12 relative overflow-hidden shadow-2xl">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
            <div class="lg:col-span-7">
              <h3 class="heading-split text-white mb-4">
                Don't See Your Game? <span class="text-tribe-gold">Bring It to Campus.</span>
              </h3>

              <p class="text-[15px] sm:text-[17px] leading-[1.65] text-white/85 mb-6">
                Love a game that isn't listed yet (like <em>Mortal Kombat</em>, <em>Tekken</em>, <em>Clash Royale</em>, or <em>Brawl Stars</em>)? When any game gets <strong>15 student votes</strong>, we unlock an official WhatsApp group and tournament prize support for it!
              </p>

              <a
                href="/register?game=Pitch%20a%20Game%20(Mortal%20Kombat%20%2F%20Tekken%20%2F%20Clash%20Royale%20%2F%20Brawl%20Stars%20%2F%20Apex)"
                class="primary-button-white select-division-trigger w-full sm:w-auto justify-center !py-3 sm:!py-3.5 text-sm sm:text-base text-center inline-flex"
              >
                <span>Vote for Your Game in Form</span>
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>

            <!-- Live 15-Vote Threshold Tracker Preview -->
            <div class="lg:col-span-5 bg-[#131211] rounded-[16px] sm:rounded-[20px] p-4 sm:p-6 border-2 border-[#202835]">
              <div class="flex flex-col xs:flex-row xs:items-center justify-between gap-1 mb-4">
                <span class="font-mono text-xs font-semibold uppercase tracking-wider text-white">
                  ACTIVE CAMPUS NOMINATIONS
                </span>
                <span class="font-mono text-[11px] text-[#22c55e]">
                  15 VOTES = OFFICIAL SUB-CHANNEL
                </span>
              </div>
              <div class="space-y-3">
                {
                  pitchedCandidates.map((item) => {
                    const pct = Math.min(100, Math.round((item.votes / 15) * 100));
                    return (
                      <div>
                        <div class="flex justify-between text-xs mb-1">
                          <span class="font-medium text-white">{item.name}</span>
                          <span class="font-mono text-[#fbaf17]">{item.votes} / 15 Verified Votes</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-[#191f2a] overflow-hidden">
                          <div
                            class="h-full rounded-full bg-gradient-to-r from-[#00a1e1] to-[#fbaf17]"
                            style={`width: ${pct}%;`}
                          />
                        </div>
                      </div>
                    );
                  })
                }
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Pre-select division in the registration form when a user clicks a division CTA
  document.querySelectorAll('.select-division-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const game = btn.getAttribute('data-select-game');
      if (game) {
        window.dispatchEvent(new CustomEvent('kyu:select-game', { detail: { game } }));
      }
    });
  });
</script>
