---
const competitiveTitles = [
  {
    id: 'efootball',
    title: 'eFootball Mobile',
    shortDesc: '1v1 Mobile Football. Weekly knockouts & campus tournaments for cash and CDP rewards.',
    tag: '1v1 Football',
    image: '/images/games/efootball-card.webp',
    logo: '/images/games/efootball-logo.png',
    selectValue: 'eFootball Mobile',
    buttonText: 'Join eFootball',
  },
  {
    id: 'codm',
    title: 'Call of Duty: Mobile',
    shortDesc: '5v5 Tactical FPS. Squad lobbies, Search & Destroy ladders, and CP prize pools.',
    tag: '5v5 Tactical FPS',
    image: '/images/games/codm-card.webp',
    logo: '/images/games/codm-logo.png',
    selectValue: 'Call of Duty: Mobile',
    buttonText: 'Join CODM',
  },
  {
    id: 'pubgm',
    title: 'PUBG Mobile',
    shortDesc: '4-Player Battle Royale. Custom campus rooms, squad scrims, and survival leaderboards.',
    tag: 'Battle Royale',
    image: '/images/games/pubgm-card.webp',
    logo: '/images/games/pubgm-logo.png',
    selectValue: 'PUBG Mobile',
    buttonText: 'Join PUBG Mobile',
  },
];

const casualTitles = [
  { name: 'EA Sports FC Mobile', badge: '/images/games/fc-mobile-badge.webp' },
  { name: 'Free Fire', badge: '/images/games/freefire-badge.png' },
  { name: 'Mobile Legends', badge: '/images/games/mlbb-badge.png' },
  { name: 'Ludo King', badge: '/images/games/ludo-badge.png' },
  { name: 'Chess.com', badge: '/images/games/chess-badge.png' },
];
---

<section id="games" class="relative scroll-mt-24">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Section Header -->
        <div class="flex flex-col items-start lg:items-center lg:text-center mb-12 sm:mb-16">
          <h2 class="heading-section text-white max-w-4xl mb-4">
            Pick Your Game. <span class="text-tribe-gold">Find Your Squad.</span>
          </h2>
          <p class="text-[17px] sm:text-[19px] leading-[1.6] text-white/80 max-w-2xl">
            Whether you want to dominate campus tournaments or chill with friends between lectures, grab your spot in the official roster.
          </p>
        </div>

        <!-- Featured Games Grid with Photo Backgrounds -->
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8 mb-12 sm:mb-16">
          {
            competitiveTitles.map((game) => (
              <article class="group relative rounded-[22px] sm:rounded-[26px] overflow-hidden border-[2px] sm:border-[2.5px] border-[#222938] bg-[#12151c] flex flex-col justify-end min-h-[420px] sm:min-h-[460px] p-6 sm:p-7 transition-transform duration-200 ease-out hover:border-[#fbaf17] hover:-translate-y-1">
                <!-- Background Image Covering Card -->
                <img
                  src={game.image}
                  alt={game.title}
                  class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-500 ease-out group-hover:scale-105"
                  loading="lazy"
                />

                <!-- High-contrast dark gradient overlays -->
                <div class="absolute inset-0 bg-gradient-to-t from-[#0b0d13] via-[#0b0d13]/75 to-transparent"></div>
                <div class="absolute inset-0 bg-black/25"></div>

                <!-- Card Content Overlay -->
                <div class="relative z-10 flex flex-col justify-end h-full">
                  <div class="flex items-center justify-between gap-3 mb-3">
                    <span class="inline-block px-3 py-1 rounded-full bg-black/85 border border-white/20 text-[11px] font-semibold uppercase tracking-wider text-tribe-gold">
                      {game.tag}
                    </span>
                    {game.logo && (
                      <img
                        src={game.logo}
                        alt=""
                        class="h-7 max-w-[90px] object-contain opacity-90 group-hover:opacity-100 transition-opacity"
                        loading="lazy"
                      />
                    )}
                  </div>

                  <h3 class="text-2xl sm:text-[26px] font-black text-white leading-tight mb-2 group-hover:text-tribe-gold transition-colors">
                    {game.title}
                  </h3>

                  <p class="text-[13.5px] sm:text-[14px] text-white/85 leading-snug mb-5">
                    {game.shortDesc}
                  </p>

                  <a
                    href={`/register?game=${encodeURIComponent(game.selectValue)}`}
                    class="primary-button-white w-full justify-center !py-2.5 sm:!py-3 text-sm font-bold text-center"
                  >
                    <span>{game.buttonText}</span>
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                    </svg>
                  </a>
                </div>
              </article>
            ))
          }
        </div>

        <!-- Casual & Fun Rooms Banner -->
        <div class="rounded-[22px] sm:rounded-[26px] bg-gradient-to-r from-[#00a1e1]/20 via-[#161f30] to-[#131722] border-[2px] sm:border-[2.5px] border-[#00a1e1]/40 p-6 sm:p-10">
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-10 items-center">
            <div class="lg:col-span-7">
              <span class="inline-block px-3 py-1 rounded-full bg-[#00a1e1]/20 border border-[#00a1e1]/40 text-[11px] font-semibold uppercase tracking-wider text-[#00a1e1] mb-3">
                Zero Pressure • Pure Vibes
              </span>
              <h3 class="heading-split text-white text-2xl sm:text-3xl mb-3">
                Casual &amp; Social Gaming Rooms
              </h3>
              <p class="text-[15px] sm:text-[16px] text-white/80 leading-relaxed mb-4">
                Play for fun between lectures. Weekly casual matches, fun rooms, and community drops with zero stress.
              </p>
              <div class="flex flex-wrap gap-2 sm:gap-2.5">
                {
                  casualTitles.map((game) => (
                    <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-xl bg-black/50 border border-white/10 text-xs sm:text-sm font-medium text-white">
                      {game.badge && (
                        <img
                          src={game.badge}
                          alt=""
                          class="w-4 h-4 object-contain rounded"
                          loading="lazy"
                        />
                      )}
                      <span>{game.name}</span>
                    </span>
                  ))
                }
              </div>
            </div>

            <div class="lg:col-span-5 flex flex-col justify-center">
              <a
                href="/register?game=Community%20Fun%20Rooms%20(FC%20Mobile%20%2F%20Free%20Fire%20%2F%20MLBB%20%2F%20Chess%20%2F%20Ludo)"
                class="primary-button-gold w-full justify-center !py-3 sm:!py-3.5 text-sm sm:text-base text-center"
              >
                <span>Join Casual Fun Rooms</span>
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Pre-select division in the registration form when a user clicks a division CTA
  document.querySelectorAll('.select-division-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const game = btn.getAttribute('data-select-game');
      if (game) {
        window.dispatchEvent(new CustomEvent('kyu:select-game', { detail: { game } }));
      }
    });
  });
</script>
      </div>
    </div>
  </div>
</section>

<script>
  // Pre-select division in the registration form when a user clicks a division CTA
  document.querySelectorAll('.select-division-trigger').forEach((btn) => {
    btn.addEventListener('click', () => {
      const game = btn.getAttribute('data-select-game');
      if (game) {
        window.dispatchEvent(new CustomEvent('kyu:select-game', { detail: { game } }));
      }
    });
  });
</script>
