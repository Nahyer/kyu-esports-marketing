---
const faqItems = [
  {
    question: 'What is CDP and how do I redeem it?',
    answer:
      'CDP (Carry1st Discount Points) are club points you win in tournaments and matches. You can swap them immediately for Safaricom/Airtel airtime, data bundles, COD Points, eFootball coins, Free Fire diamonds, or Google Play vouchers on the Carry1st Shop.',
  },
  {
    question: 'Do I need a high-end gaming phone or PC to join?',
    answer:
      'Not at all. Every featured game runs smoothly on regular everyday Android and iOS smartphones. You just need a phone and internet connection.',
  },
  {
    question: 'Can I join if I only play casually?',
    answer:
      'Yes, absolutely! Over half our members are casual players. We have weekly low-stress Fun Rooms for FC Mobile, Free Fire, Ludo, and Chess where you can hang out and play socially.',
  },
  {
    question: 'Will this get in the way of my classes and exams?',
    answer:
      'No. Matches, tournaments, and game nights are scheduled strictly for evenings and weekends around official KyU lecture timetables so studies always come first.',
  },
  {
    question: 'How much does it cost to join?',
    answer:
      'It is 100% free. There are zero membership fees or registration charges for Kirinyaga University students.',
  },
];
---

<section id="faq" class="relative scroll-mt-24">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Section Header -->
        <div class="flex flex-col items-start lg:items-center lg:text-center mb-12">
          <h2 class="heading-section text-white max-w-4xl">
            Frequently Asked <span class="text-tribe-gold">Questions</span>
          </h2>
        </div>

        <!-- 20px Rounded Accordion List (.accordion-item---brix archetype) -->
        <div class="max-w-4xl mx-auto space-y-4">
          {
            faqItems.map((item, idx) => (
              <details class="faq-accordion-item group" open={idx === 0}>
                <summary class="cursor-pointer list-none px-4.5 py-4 sm:px-8 sm:py-6 flex items-center justify-between gap-3 sm:gap-4 select-none">
                  <span class="text-base sm:text-[20px] font-bold text-white group-hover:text-[#fbaf17] transition-colors leading-snug">
                    {item.question}
                  </span>
                  <span class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#161b25] border border-[#202835] flex items-center justify-center shrink-0 text-[#fbaf17] group-open:rotate-45 group-open:bg-[#fbaf17] group-open:text-black transition-all duration-200">
                    <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14" />
                    </svg>
                  </span>
                </summary>
                <div class="px-4.5 pb-5 sm:px-8 sm:pb-7 pt-1 text-[14px] sm:text-[16px] leading-[1.65] text-white/80 border-t border-white/10">
                  {item.answer}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
