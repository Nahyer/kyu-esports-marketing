---
const faqItems = [
  {
    question: 'How much does it cost to join?',
    answer:
      'Zero entry fees. Joining the Kirinyaga University Gaming Club is 100% free for all students.',
  },
  {
    question: 'What is CDP and how do I redeem it?',
    answer:
      'CDP (Carry1st Discount Points) are earned in weekly rooms and campus matches. You can swap them directly on the Carry1st Shop for Safaricom/Airtel airtime, data bundles, COD Points, eFootball coins, or vouchers.',
  },
  {
    question: 'Do I need a high-end phone or PC?',
    answer:
      'Not at all. Every game in our roster runs on standard mobile phones. If you have an everyday smartphone and an internet connection, you can play.',
  },
  {
    question: 'Can I play casually between classes?',
    answer:
      'Yes. Over half our community plays casually. We host weekly low-pressure fun rooms for FC Mobile, Free Fire, Ludo, and Chess designed for quick breaks.',
  },
  {
    question: 'Will matches conflict with lectures and exams?',
    answer:
      'No. Matches, tournaments, and sessions are scheduled strictly for evenings and weekends around official KyU lecture timetables so coursework always comes first.',
  },
];
---

<section id="faq" class="relative scroll-mt-24">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Section Header -->
        <div class="flex flex-col items-start lg:items-center lg:text-center mb-12 sm:mb-16">
          <p class="text-xs font-semibold uppercase tracking-[0.16em] text-[#fbaf17] mb-2">
            GOT QUESTIONS?
          </p>
          <h2 class="heading-section text-white max-w-4xl">
            Frequently Asked <span class="text-tribe-gold">Questions</span>
          </h2>
        </div>

        <!-- Clean Editorial Bordered Accordion List (No boxy cards) -->
        <div class="max-w-3xl mx-auto divide-y divide-[#202835] border-y border-[#202835]">
          {
            faqItems.map((item) => (
              <details class="group py-5 sm:py-6 cursor-pointer select-none">
                <summary class="list-none flex items-center justify-between gap-4 text-left">
                  <span class="text-lg sm:text-xl font-bold text-white group-hover:text-[#fbaf17] transition-colors leading-snug">
                    {item.question}
                  </span>
                  <span class="w-8 h-8 rounded-full flex items-center justify-center shrink-0 text-[#7e8a9e] group-hover:text-white group-open:text-[#fbaf17] group-open:rotate-45 transition-transform transition-colors duration-150 ease-out">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m-7-7h14" />
                    </svg>
                  </span>
                </summary>
                <div class="pt-3 pb-2 text-[15px] sm:text-[16px] leading-[1.65] text-white/75 pr-8">
                  {item.answer}
                </div>
              </details>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
