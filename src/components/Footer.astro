---

<!-- Authentic Tribe-Structure Footer (<section class="footer">) -->
<section class="footer bg-black border-t border-[#202835]">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-medium pt-12 pb-24 lg:py-16">
        <div class="footer-component flex flex-col gap-12 lg:gap-14">
          <!-- Top Row: .div-block-2746-copy -->
          <div class="div-block-2746-copy flex flex-col lg:flex-row justify-between gap-10 lg:gap-16">
            <!-- Left Column: .footer-left -->
            <div class="footer-left max-w-md flex flex-col gap-5">
              <!-- Brand Logo Lockup (.margin-bottom.margin-small) -->
              <div class="margin-bottom margin-small flex items-center gap-3">
                <a href="#" class="nav-logo-link flex items-center gap-3 group">
                  <img src="/images/kyu_logo2.svg" alt="Kirinyaga University" class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105" />
                  <span class="w-[1px] h-6 bg-white/20"></span>
                  <img src="/images/tribelogo.svg" alt="Tribe by Carry1st" class="h-8 sm:h-9 w-auto object-contain transition-transform group-hover:scale-105" />
                </a>
              </div>

              <!-- Brand Attribution Text -->
              <div class="space-y-1 text-sm text-white/80">
                <p class="font-display-impact text-xl text-white tracking-wider">
                  KIRINYAGA UNIVERSITY ESPORTS
                </p>
                <p class="text-xs text-[#7e8a9e] leading-relaxed">
                  Kirinyaga University Directorate of Sports &amp; Student Welfare.<br />
                  Kutus, Kirinyaga County, Kenya. Official Campus Chapter of Tribe by Carry1st.
                </p>
              </div>

              <!-- Follow Us On (.div-block-2739 + .div-block-2577) -->
              <div class="pt-2">
                <div class="div-block-2739 mb-3">
                  <p class="text-size-regular-3 text-color-white text-sm font-medium text-white/90">
                    Follow us on:
                  </p>
                </div>
                <div class="div-block-2577 flex items-center gap-4 text-[#7e8a9e]">
                  {
                    socialLinks.map((social) => (
                      <a
                        href={social.href}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={social.name}
                        class="link-block w- inline-block p-2 rounded-full border border-white/10 hover:border-[#fbaf17] text-white/70 hover:text-[#fbaf17] transition-all hover:-translate-y-0.5"
                        set:html={social.svg}
                      />
                    ))
                  }
                </div>
              </div>
            </div>

            <!-- Right Column: .footer-right -->
            <div class="footer-right grid grid-cols-1 sm:grid-cols-2 gap-8 lg:gap-14">
              <!-- Column 1: Quick Links (.div-block-2738._1) -->
              <div class="div-block-2738 _1 flex flex-col gap-2.5">
                <div class="margin-bottom margin-tiny mb-2">
                  <p class="text-size-medium-9 text-weight-semibold text-color-white text-sm font-semibold uppercase tracking-wider text-white">
                    Quick Links
                  </p>
                </div>
                {
                  quickLinks.map((link) => (
                    <a
                      href={link.href}
                      class="link-5 grey-2 text-sm text-[#7e8a9e] hover:text-[#fbaf17] transition-colors py-0.5"
                    >
                      {link.label}
                    </a>
                  ))
                }
              </div>

              <!-- Column 2: Administrative Channels & Support -->
              <div class="div-block-2738 flex flex-col gap-3">
                <div class="margin-bottom margin-tiny mb-2">
                  <p class="text-size-medium-9 text-weight-semibold text-color-white text-sm font-semibold uppercase tracking-wider text-white">
                    Contact &amp; Support
                  </p>
                </div>
                <div class="flex flex-col gap-1 text-sm text-[#7e8a9e]">
                  <span class="text-xs uppercase tracking-wider text-white/50">Directorate of Sports:</span>
                  <a
                    href="mailto:sports@kyu.ac.ke"
                    class="link-5 grey-2 text-white hover:text-[#fbaf17] transition-colors font-mono text-xs"
                  >
                    sports@kyu.ac.ke
                  </a>
                </div>
                <div class="flex flex-col gap-1 text-sm text-[#7e8a9e]">
                  <span class="text-xs uppercase tracking-wider text-white/50">Student Secretariat:</span>
                  <a
                    href="mailto:esports@students.kyu.ac.ke"
                    class="link-5 grey-2 text-white hover:text-[#fbaf17] transition-colors font-mono text-xs"
                  >
                    esports@students.kyu.ac.ke
                  </a>
                </div>
              </div>
            </div>
          </div>

          <!-- Bottom Row: .div-block-2742._2 -->
          <div class="div-block-2742 _2 pt-8 border-t border-[#202835] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-[#7e8a9e]">
            <p class="text-size-small grey-2 text-center sm:text-left">
              Copyright © 2026 Kirinyaga University Esports &amp; Carry1st. All Rights Reserved.
            </p>
            <div class="div-block-2737 flex flex-wrap items-center justify-center sm:justify-end gap-4 sm:gap-6">
              <a href="/privacy" class="link-block-8">
                <p class="text-size-regular-3 grey-2 underline hover:text-[#fbaf17] transition-colors text-xs">
                  Club Privacy Policy
                </p>
              </a>
              <a href="/terms" class="link-block-8">
                <p class="text-size-regular-3 grey-2 underline hover:text-[#fbaf17] transition-colors text-xs">
                  Terms of Service &amp; Rules
                </p>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
