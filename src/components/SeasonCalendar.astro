---
const seasonSchedule = [
  {
    period: 'October 2026',
    milestone: 'Club Intake Drive',
    format: 'Online',
    formatStyle: 'online',
    objectives: 'Campus-wide welcome & onboarding; building our initial 150+ member clan.',
  },
  {
    period: 'November 2026',
    milestone: 'KyU Campus Trials',
    format: 'Online',
    formatStyle: 'online',
    objectives: 'Friendly campus ranking matches, division brackets, and practice scrims.',
  },
  {
    period: 'December 2026',
    milestone: 'Semester I Split Finals',
    format: 'Online',
    formatStyle: 'online',
    objectives: 'First semester finals; CDP reward points and prize distributions.',
  },
  {
    period: 'January 2027',
    milestone: 'Inter-University Scrims',
    format: 'Online',
    formatStyle: 'online',
    objectives: 'Challenge partner university esports clubs across Kenya.',
  },
  {
    period: 'February 2027',
    milestone: 'Semester II Intake',
    format: 'Online / Hybrid',
    formatStyle: 'hybrid',
    objectives: 'Welcome freshers and expand community past 200+ active members.',
  },
  {
    period: 'March 2027',
    milestone: 'Inter-Faculty LAN Cup',
    format: 'In-Person (LAN)',
    formatStyle: 'lan',
    objectives: 'On-campus physical gaming hangout and inter-school tournament showdown.',
  },
  {
    period: 'April 2027',
    milestone: 'All-Campus Gaming Week',
    format: 'In-Person (LAN)',
    formatStyle: 'lan',
    objectives: 'Campus-wide gaming showcase, casual fun rooms, and student prizes.',
  },
  {
    period: 'May 2027',
    milestone: 'Annual Club Review',
    format: 'Administrative',
    formatStyle: 'admin',
    objectives: 'Certificates of completion and annual review with university sports leadership.',
  },
];

const getBadgeClasses = (style: string) => {
  switch (style) {
    case 'lan':
      return 'bg-[#fbaf17] text-black border-[#fbaf17] font-bold';
    case 'hybrid':
      return 'bg-[#22c55e]/15 text-[#22c55e] border-[#22c55e]/40 font-semibold';
    case 'admin':
      return 'bg-white/10 text-white/80 border-white/20 font-medium';
    default:
      return 'bg-[#00a1e1]/15 text-[#00a1e1] border-[#00a1e1]/40 font-semibold';
  }
};
---

<section id="calendar" class="relative scroll-mt-24">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Section Header -->
        <div class="flex flex-col items-start lg:items-center lg:text-center mb-12">
          <h2 class="heading-section text-white max-w-4xl mb-3">
            2026–2027 Season &amp; <span class="text-tribe-gold">Activity Calendar</span>
          </h2>
          <p class="text-[16px] sm:text-[18px] leading-[1.6] text-white/80 max-w-3xl">
            Planned events aligned with Kirinyaga University semesters and Tribe Campus community growth.
          </p>
        </div>

        <!-- Elevated 26px Rounded Schedule Matrix (.page-wrapper.dark archetype) -->
        <div class="rounded-[20px] sm:rounded-[26px] bg-[#191f2a] border-[2px] sm:border-[3px] border-[#202835] overflow-hidden shadow-2xl">
          <!-- Desktop Architectural Table -->
          <div class="hidden md:block overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-[#161b25] border-b-2 border-[#202835] text-xs font-mono uppercase tracking-[0.14em] text-[#7e8a9e]">
                  <th class="py-5 px-7">Month</th>
                  <th class="py-5 px-7">Event</th>
                  <th class="py-5 px-7">Format</th>
                  <th class="py-5 px-7">What's Happening</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-[#202835]">
                {
                  seasonSchedule.map((row) => (
                    <tr class="hover:bg-white/[0.03] transition-colors">
                      <td class="py-5 px-7 font-mono text-sm font-bold text-[#fbaf17] whitespace-nowrap">
                        {row.period}
                      </td>
                      <td class="py-5 px-7 text-[17px] font-bold text-white whitespace-nowrap">
                        {row.milestone}
                      </td>
                      <td class="py-5 px-7 whitespace-nowrap">
                        <span
                          class={`inline-flex items-center px-3.5 py-1 rounded-full text-xs font-mono uppercase tracking-wider border ${getBadgeClasses(
                            row.formatStyle
                          )}`}
                        >
                          {row.format}
                        </span>
                      </td>
                      <td class="py-5 px-7 text-[15px] leading-relaxed text-white/85">
                        {row.objectives}
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <!-- Mobile Stacked Schedule Cards -->
          <div class="md:hidden divide-y divide-[#202835]">
            {
              seasonSchedule.map((row) => (
                <div class="p-4.5 xs:p-5 sm:p-6 flex flex-col gap-2.5 sm:gap-3">
                  <div class="flex flex-wrap xs:flex-nowrap items-center justify-between gap-2">
                    <span class="font-mono text-xs font-bold uppercase tracking-wider text-[#fbaf17]">
                      {row.period}
                    </span>
                    <span
                      class={`inline-flex items-center px-2.5 py-0.5 rounded-full text-[10px] xs:text-[11px] font-mono uppercase tracking-wider border ${getBadgeClasses(
                        row.formatStyle
                      )}`}
                    >
                      {row.format}
                    </span>
                  </div>
                  <h3 class="text-lg font-bold text-white">{row.milestone}</h3>
                  <p class="text-sm text-white/80 leading-relaxed">{row.objectives}</p>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
