---
const redemptionItems = [
  'Google Play Credits',
  'Call of Duty CP',
  'eFootball Coins',
  'Mobile Airtime',
  'Data Bundles',
];
---

<section id="rewards" class="relative scroll-mt-24">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-vertical padding-huge">
        <!-- Section Header -->
        <div class="flex flex-col items-start lg:items-center lg:text-center mb-14">
          <h2 class="heading-section text-white max-w-4xl mb-4">
            Play Games. <span class="text-tribe-gold">Get Rewarded.</span>
          </h2>
          <p class="text-[17px] sm:text-[19px] leading-[1.6] text-white/80 max-w-3xl">
            Win campus matches, complete fun challenges, and earn Carry1st Discount Points (CDP) to redeem for actual goodies you use every day.
          </p>
        </div>

        <!-- Block 1: Pillar 1 — High-Contrast Tribe Gold Split Card (.community-2 archetype) -->
        <div class="split-card-gold p-5 sm:p-8 lg:p-14 mb-8 shadow-2xl">
          <!-- Subtle Geometric Watermark -->
          <div
            class="pointer-events-none absolute -bottom-24 -left-24 w-96 h-96 rounded-full border-[40px] border-black/[0.06]"
          >
          </div>

          <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
            <!-- Left Text Column (7 cols) -->
            <div class="lg:col-span-7 flex flex-col justify-between">
              <h3 class="heading-split text-black mb-6">
                What is CDP &amp; How Do You Spend It?
              </h3>

              <div class="space-y-4 text-black/90 text-[15px] sm:text-[17px] leading-[1.6]">
                <p>
                  <strong class="font-bold text-black">What is CDP?</strong> CDP (Carry1st Discount Points) are the official reward points of our gaming club. 1 CDP is used just like cash on the Carry1st Shop.
                </p>

                <p>
                  <strong class="font-bold text-black">Instant Redemptions:</strong> Points can be redeemed instantly for <strong class="font-bold text-black">Safaricom &amp; Airtel airtime, data bundles, Call of Duty CP, eFootball coins, Free Fire diamonds, and Google Play vouchers</strong>.
                </p>

                <p>
                  <strong class="font-bold text-black">Campus Prize Pools:</strong> Carry1st provides our campus with up to <span class="font-mono font-bold underline">259,000 CDP</span> every month for tournament prizes, friendly matches, and community events.
                </p>
              </div>
            </div>

            <!-- Right Interactive/Visual Telemetry Panel (5 cols, Dark #121110 card inside Gold card) -->
            <div class="lg:col-span-5 bg-[#121110] text-white rounded-[18px] sm:rounded-[22px] p-4 sm:p-7 lg:p-8 border-[2px] sm:border-[3px] border-black shadow-2xl flex flex-col justify-between gap-6">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class="text-[11px] sm:text-xs font-mono uppercase tracking-widest text-[#7e8a9e]">
                    MONTHLY CAMPUS ALLOCATION
                  </span>
                </div>

                <div class="flex flex-wrap xs:flex-nowrap items-baseline justify-between gap-2 mb-4">
                  <div>
                    <span class="text-[11px] sm:text-xs text-[#7e8a9e] block">Base Tier</span>
                    <span class="font-mono text-lg sm:text-2xl font-bold text-white">52,000 CDP</span>
                  </div>
                  <div class="text-left xs:text-right">
                    <span class="text-[11px] sm:text-xs text-[#fbaf17] block">Emerald Tier Max</span>
                    <span class="font-mono text-xl sm:text-3xl font-bold text-[#fbaf17]">259,000 CDP</span>
                  </div>
                </div>

                <!-- Visual Tier Scaling Bar -->
                <div class="w-full h-3.5 rounded-full bg-[#191f2a] p-0.5 overflow-hidden border border-[#202835] mb-2">
                  <div
                    class="h-full rounded-full w-4/5"
                    style="background: linear-gradient(90deg, #00a1e1 0%, #fbaf17 65%, #22c55e 100%);"
                  >
                  </div>
                </div>
                <div class="flex justify-between text-[9.5px] xs:text-[11px] font-mono text-[#7e8a9e] tracking-tight">
                  <span>BASE (52K)</span>
                  <span>CONF</span>
                  <span>PREMIER</span>
                  <span class="text-[#22c55e] font-semibold">EMERALD (259K)</span>
                </div>
              </div>

              <div class="border-t border-white/10 pt-5">
                <span class="text-[11px] sm:text-xs font-mono uppercase tracking-widest text-[#7e8a9e] block mb-3">
                  INSTANT CARRY1ST SHOP REDEMPTIONS
                </span>
                <div class="flex flex-wrap gap-1.5 sm:gap-2">
                  {
                    redemptionItems.map((item) => (
                      <span class="text-[11px] sm:text-xs font-medium bg-[#191f2a] border border-[#202835] text-white/90 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-full">
                        {item}
                      </span>
                    ))
                  }
                </div>
              </div>

              <a
                href="/register"
                class="primary-button-white w-full justify-center !py-3 sm:!py-3.5 text-sm sm:text-base text-center"
              >
                <span>Get Started</span>
                <svg class="w-4 h-4 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Block 2: Pillars 2 & 3 — Obsidian Split Cards (.communituy-3 archetype) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 sm:gap-8">
          <!-- Pillar 2 Card -->
          <article class="split-card-obsidian p-5 sm:p-8 lg:p-11 flex flex-col justify-between">
            <div>
              <h3 class="heading-split text-[#fbaf17] mb-6">
                Leadership, Certificates &amp; CV Boost
              </h3>

              <div class="space-y-4 text-[16px] leading-[1.65] text-white/80">
                <p>
                  <strong class="text-white font-semibold">Real Recognition:</strong> Team captains, tournament refs, and campus organizers receive official certificates and recommendation letters to boost their professional resumes.
                </p>

                <p>
                  <strong class="text-white font-semibold">Tribe Leadership Track:</strong> Top campus leaders get access to community management training, stipends, and networking with Africa's gaming industry pros.
                </p>
              </div>
            </div>
          </article>

          <!-- Pillar 3 Card -->
          <article class="split-card-obsidian p-5 sm:p-8 lg:p-11 flex flex-col justify-between">
            <div>
              <h3 class="heading-split text-[#fbaf17] mb-6">
                Inter-University Pride &amp; Tournaments
              </h3>

              <div class="space-y-4 text-[16px] leading-[1.65] text-white/80">
                <p>
                  <strong class="text-white font-semibold">Represent Kirinyaga:</strong> Challenge other universities across Kenya in scheduled weekend scrimmages and regional tournaments.
                </p>

                <p>
                  <strong class="text-white font-semibold">Open to Everyone:</strong> From solo warriors looking for squad-mates to ready-made teams, anyone can enter the trials and claim university bragging rights.
                </p>
              </div>
            </div>
          </article>
        </div>
      </div>
    </div>
  </div>
</section>
