---
import RootLayout from '../layouts/RootLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const quickDestinations = [
  {
    title: 'Game Divisions',
    desc: 'Browse eFootball, Call of Duty: Mobile, PUBG Mobile, and campus fun titles.',
    href: '/#games',
    label: 'Explore Titles',
  },
  {
    title: 'Roster Registration',
    desc: 'Join the Kirinyaga University gaming roster in 60 seconds with 0 KES entry fee.',
    href: '/register',
    label: 'Join Roster',
  },
  {
    title: 'Tribe Economy & Prizes',
    desc: 'Learn about weekly match airtime drops, tournament prize pools, and CDP points.',
    href: '/#reach',
    label: 'View Rewards',
  },
  {
    title: 'Season Schedule',
    desc: 'Check tournament dates, qualifier weekends, and casual evening rooms.',
    href: '/#events',
    label: 'See Calendar',
  },
];
---

<RootLayout
  title="Page Not Found — Kirinyaga University Esports"
  description="The page you requested could not be located on the Kirinyaga University Esports platform."
>
  <Navbar />

  <main class="flex-1 flex flex-col justify-center bg-[#121110] text-white">
    <section class="relative pt-28 pb-20 sm:pt-36 sm:pb-28 lg:pt-40 lg:pb-32 overflow-hidden">
      <!-- Muted Dark Field Ambient Grid (restrained, 2% opacity) -->
      <div
        class="pointer-events-none absolute inset-0 opacity-[0.03]"
        style="background-image: linear-gradient(#ffffff 1px, transparent 1px), linear-gradient(90deg, #ffffff 1px, transparent 1px); background-size: 64px 64px;"
        aria-hidden="true"
      >
      </div>

      <div class="padding-global relative z-10">
        <div class="container-large">
          <div class="max-w-3xl mx-auto flex flex-col items-center text-center">
            <!-- Massive, confident editorial numeral without AI fluff -->
            <div class="font-display-impact text-[96px] sm:text-[140px] lg:text-[180px] leading-none tracking-tight text-white mb-2 select-none">
              4<span class="text-[#fbaf17]">0</span>4
            </div>

            <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight mb-4">
              This match lobby does not exist.
            </h1>

            <p class="text-sm sm:text-base text-white/70 max-w-xl leading-relaxed mb-8">
              The link you followed has either moved, expired, or was mistyped. Let’s get you back into the match lobby.
            </p>

            <!-- Grounded Action Row -->
            <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto mb-14">
              <a href="/" class="primary-button-gold w-full sm:w-auto justify-center !py-3.5 !px-6 text-sm font-bold">
                <span>Return to Campus Hub</span>
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
              </a>

              <button
                type="button"
                data-status-drawer-trigger
                class="primary-button-outline w-full sm:w-auto justify-center !py-3.5 !px-6 text-sm font-semibold cursor-pointer"
              >
                <span class="w-2 h-2 rounded-full bg-[#fbaf17]"></span>
                <span>Check Your Status</span>
              </button>
            </div>

            <!-- Contextual Navigation Matrix (4 clean functional destination panels) -->
            <div class="w-full pt-10 border-t border-[#222834] text-left">
              <h2 class="text-xs font-mono uppercase tracking-wider text-white/50 mb-4 text-center sm:text-left">
                Active Campus Hub Sections:
              </h2>

              <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3.5">
                {
                  quickDestinations.map((dest) => (
                    <a
                      href={dest.href}
                      class="p-4 rounded-xl bg-[#161a22] hover:bg-[#1a202a] border border-[#252c38] hover:border-[#384355] transition-all duration-150 flex flex-col justify-between group block text-left"
                    >
                      <div class="mb-3">
                        <div class="text-[13px] font-bold text-white group-hover:text-[#fbaf17] transition-colors mb-1">
                          {dest.title}
                        </div>
                        <p class="text-xs text-white/60 leading-relaxed line-clamp-2">
                          {dest.desc}
                        </p>
                      </div>
                      <div class="text-[11px] font-semibold text-[#fbaf17] inline-flex items-center gap-1">
                        <span>{dest.label}</span>
                        <span class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
                      </div>
                    </a>
                  ))
                }
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</RootLayout>
