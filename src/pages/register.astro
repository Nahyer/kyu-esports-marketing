---
import RootLayout from '../layouts/RootLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import RegistrationEngine from '../components/RegistrationEngine';
---

<RootLayout
  title="Join KyU Esports — 60-Second Roster Registration"
  description="Sign up for Kirinyaga University's official gaming club powered by Tribe & Carry1st. Set up your free account, pick your game, and join the official WhatsApp clan."
>
  <!-- Global Navigation Bar -->
  <Navbar />

  <main class="flex-1 bg-white text-[#161b25]">
    <!-- Top Stage Header -->
    <section class="relative pt-24 pb-8 sm:pt-28 sm:pb-12 lg:pt-32 bg-white border-b border-slate-200 overflow-hidden">
      <!-- Ambient Glows -->
      <div
        class="pointer-events-none absolute inset-0 opacity-15"
        style="background: radial-gradient(circle at 50% 0%, rgba(0, 161, 225, 0.25), transparent 60%), radial-gradient(circle at 85% 60%, rgba(251, 175, 23, 0.15), transparent 50%);"
      >
      </div>

      <div class="padding-global relative z-10">
        <div class="container-large">
          <div class="max-w-4xl mx-auto text-center flex flex-col items-center">
            <h1 class="heading-hero text-[#161b25] mb-4">
              Welcome to <span class="text-[#fbaf17]">the Club</span>
            </h1>

            <p class="text-[16px] sm:text-[18px] leading-[1.6] text-slate-600 max-w-2xl font-medium mb-8">
              Join Kirinyaga University's official student gaming community. Complete the quick steps below to claim your roster spot.
            </p>

            <!-- 3 Steps Segmented Progress Track in Hero Section -->
            <div class="w-full max-w-2xl mx-auto pt-4">
              <div class="grid grid-cols-3 gap-1.5 sm:gap-3 p-1.5 sm:p-2 bg-slate-100/90 rounded-2xl border border-slate-200/90 shadow-xs">
                {/* Step 1: Active */}
                <div class="flex items-center gap-2 sm:gap-3 p-2 sm:p-3 rounded-xl bg-white shadow-xs border border-slate-200/70 min-w-0">
                  <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-lg bg-[#161b25] text-[#fbaf17] font-mono font-bold text-xs flex items-center justify-center shadow-xs shrink-0">
                    1
                  </div>
                  <div class="flex flex-col text-left min-w-0">
                    <span class="text-[11px] sm:text-[13px] font-bold text-[#161b25] truncate leading-tight">
                      Carry1st Profile
                    </span>
                    <span class="text-[10px] sm:text-[11px] text-slate-500 font-medium truncate hidden xs:block">
                      Rewards Wallet
                    </span>
                  </div>
                </div>

                {/* Step 2: Next */}
                <div class="flex items-center gap-2 sm:gap-3 p-2 sm:p-3 rounded-xl bg-white/60 border border-slate-200/50 min-w-0">
                  <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-lg bg-slate-200/80 text-slate-700 font-mono font-bold text-xs flex items-center justify-center shrink-0">
                    2
                  </div>
                  <div class="flex flex-col text-left min-w-0">
                    <span class="text-[11px] sm:text-[13px] font-bold text-[#161b25] truncate leading-tight">
                      Student Details
                    </span>
                    <span class="text-[10px] sm:text-[11px] text-slate-500 font-medium truncate hidden xs:block">
                      ID &amp; Game
                    </span>
                  </div>
                </div>

                {/* Step 3: Upcoming */}
                <div class="flex items-center gap-2 sm:gap-3 p-2 sm:p-3 rounded-xl min-w-0">
                  <div class="w-6 h-6 sm:w-8 sm:h-8 rounded-lg bg-slate-200/50 text-slate-400 font-mono font-bold text-xs flex items-center justify-center shrink-0">
                    3
                  </div>
                  <div class="flex flex-col text-left min-w-0">
                    <span class="text-[11px] sm:text-[13px] font-semibold text-slate-500 truncate leading-tight">
                      WhatsApp Access
                    </span>
                    <span class="text-[10px] sm:text-[11px] text-slate-400 font-medium truncate hidden xs:block">
                      Group Link
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Main Registration Shell Section -->
    <section class="relative py-12 sm:py-16 lg:py-20 bg-white">
      <div class="padding-global">
        <div class="container-large max-w-6xl mx-auto">
          <!-- Dual-Tone 40px Split Conversion Card (.contact-component.comm) -->
          <RegistrationEngine client:load />
        </div>
      </div>
    </section>
  </main>

  <!-- Institutional Footer -->
  <Footer />
</RootLayout>
